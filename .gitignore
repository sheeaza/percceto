# CMake build tree
build/

# Object/archive files from any out-of-tree or ad-hoc compile
*.o
*.a

# Traces written by pftrace runs
*.pftrace

# clangd: index cache, plus the root symlink into build/
.cache/
compile_commands.json

# Python bytecode from running tools/ scripts and their tests
__pycache__/
*.pyc
